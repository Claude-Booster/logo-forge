#!/usr/bin/env bash
# Blocks commits that would expose personal identifiers.
#
# Identity resolution (mirrors git's own order):
#   1. git var GIT_AUTHOR_IDENT / GIT_COMMITTER_IDENT
#      — resolves env overrides → local/global/system config → OS fallback
#   2. Belt-and-suspenders OS env check for Windows-specific vars
#      (USERNAME, USERDOMAIN, COMPUTERNAME) that git var may not surface
#
# Staged content: only added/modified lines are scanned (grep '^[+][^+]'),
# so pre-existing content in unchanged files never triggers a false positive.
# .githooks/ is excluded entirely from the file scan.
#
# Patterns: .githooks/.blocked (gitignored — never committed).
# If the file is absent the hook exits silently.
# Copy .githooks/.blocked.example to .githooks/.blocked to activate.
#
# Activate with: git config core.hooksPath .githooks

BLOCKED_FILE="$(git rev-parse --show-toplevel)/.githooks/.blocked"

[ -f "$BLOCKED_FILE" ] || exit 0

# Build a single grep -iE pattern from non-comment, non-blank lines.
# tr -d '\r' normalises Windows CRLF line endings.
PAT=$(grep -Ev '^[[:space:]]*(#|$)' "$BLOCKED_FILE" \
    | tr -d '\r' | tr '\n' '|' | sed 's/|$//')
[ -n "$PAT" ] || exit 0

FAIL=0
_block() { printf '  blocked  %s\n' "$*" >&2; FAIL=1; }

# ── 1. git var — covers env overrides + config chain + git's own OS fallback ──
for _VAR in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    _IDENT=$(git var "$_VAR" 2>/dev/null || true)
    if printf '%s\n' "$_IDENT" | grep -qiE "$PAT"; then
        _block "identity  [$_VAR]  $_IDENT"
    fi
done

# ── 2. OS env — only checked when git config is unset (mirrors git's resolution) ──
# When user.name/email is set, git never touches OS identity, so no need to check.
CFG_NAME=$(git config user.name  2>/dev/null || true)
CFG_EMAIL=$(git config user.email 2>/dev/null || true)

if [ -z "$CFG_NAME" ] || [ -z "$CFG_EMAIL" ]; then
    OS_USER="${USERNAME:-${USER:-}}"
    OS_DOMAIN="${USERDOMAIN:-}"
    OS_HOST="${COMPUTERNAME:-$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)}"

    for _LABEL_VAL in \
        "USERNAME:$OS_USER" \
        "USERDOMAIN:$OS_DOMAIN" \
        "COMPUTERNAME/hostname:$OS_HOST"
    do
        _LABEL="${_LABEL_VAL%%:*}"
        _VAL="${_LABEL_VAL#*:}"
        [ -z "$_VAL" ] && continue
        if printf '%s\n' "$_VAL" | grep -qiE "$PAT"; then
            _block "OS env    [$_LABEL]  $_VAL"
        fi
    done
fi

# ── 3. Staged diff — only added/modified lines, .githooks/ excluded ────────────
while IFS= read -r f; do
    [ -z "$f" ] && continue
    [[ "$f" == .githooks/* ]] && continue
    if git diff --cached --unified=0 -- "$f" \
        | grep -E '^[+][^+]' \
        | grep -qiE "$PAT"; then
        _block "staged    $f"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

(( FAIL == 0 )) || {
    printf '\nCommit blocked — remove or redact restricted content and retry.\n' >&2
    exit 1
}

exit 0
